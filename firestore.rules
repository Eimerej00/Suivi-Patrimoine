rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/wealthData/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'jeremie.lecorney@gmail.com');
    }
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'jeremie.lecorney@gmail.com';
    }
  }
}
